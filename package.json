{
  "name": "@cheapaimodel/sdk",
  "version": "0.1.0",
  "description": "Official lightweight TypeScript client for the CheapAIModel API (OpenAI-compatible)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["llm", "ai", "openai", "api", "cheapaimodel"],
  "repository": {
    "type": "git",
    "url": "https://github.com/cheapaimodel/typescript-sdk"
  },
  "homepage": "https://cheapaimodel.com",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.60.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
